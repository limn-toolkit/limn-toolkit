---
/**
 * The 404 every unknown URL on the domain resolves to, including under `/docs/`, whose own
 * 404 route is turned off in the Astro config so that there is exactly one.
 *
 * It is a page and not an apology: a reader who lands here followed a link that no longer
 * works, and the useful thing to give them is the four places the site actually has.
 */
import Page from "../layouts/Page.astro";
import { messages } from "../i18n";
import { DEFAULT_LOCALE, localePath } from "../lib/i18n";

const locale = DEFAULT_LOCALE;
const msg = messages(locale);
const base = import.meta.env.BASE_URL;

const destinations = [
  { key: "components", href: localePath(base, locale, "components/") },
  { key: "showcase", href: localePath(base, locale, "showcase/") },
  { key: "docs", href: `${base}docs/` },
  { key: "api", href: `${base}api/` },
] as const;
---

<Page locale={locale} titleKey="notFound.title" descriptionKey="notFound.body" noindex>
  <section class="section aura">
    <div class="wrap">
      <p class="eyebrow">{msg("notFound.eyebrow")}</p>
      <h1>{msg("notFound.heading")}</h1>
      <p class="lede">{msg("notFound.body")}</p>

      <nav class="destinations" aria-label={msg("notFound.destinationsLabel")}>
        {
          destinations.map((destination) => (
            <a class="destination" href={destination.href}>
              <span class="destination__name">
                {msg(`notFound.${destination.key}.heading` as never)}
              </span>
              <span class="destination__body">
                {msg(`notFound.${destination.key}.body` as never)}
              </span>
            </a>
          ))
        }
      </nav>

      <div class="button-row">
        <a class="button button--primary" href={localePath(base, locale)}>
          {msg("notFound.home")}
        </a>
      </div>
    </div>
  </section>
</Page>

<style>
  h1 {
    max-inline-size: 16ch;
  }

  .lede {
    margin-block: 1.25rem 0;
  }

  .destinations {
    display: grid;
    gap: 1rem;
    margin-block: 3rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .destination {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 140ms var(--ease),
      background-color 140ms var(--ease);
  }

  .destination:hover {
    border-color: var(--limn-primary);
    background-color: var(--tint);
  }

  .destination__name {
    color: var(--limn-text);
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .destination__name::after {
    content: " →";
    color: var(--limn-primary);
  }

  .destination__body {
    color: var(--limn-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
</style>
