---
/**
 * The home page. Its first job is to show the toolkit rendering, so the hero capture is
 * above the fold, eagerly loaded, and carries its intrinsic size, because the page must not
 * shift as it lands.
 *
 * Its second job is to answer "what would it take to try this" before the reader has to
 * click anything, which is why the whole install is a section here and not a separate page.
 */
import Page from "../../layouts/Page.astro";
import Figure from "../../components/Figure.astro";
import Screenshot from "../../components/Screenshot.astro";
import { limnVersion } from "../../lib/version.mjs";
import CodeBlock from "../../components/CodeBlock.astro";
import RunCommand from "../../components/RunCommand.astro";
import CodeTabs from "../../components/CodeTabs.astro";
import ThemeMosaic from "../../components/ThemeMosaic.astro";
import { localeRoutes, messages } from "../../i18n";
import { localePath, type Locale } from "../../lib/i18n";
import { snippet } from "../../lib/snippets";
import showcase from "../../generated/showcase.json";
import gallery from "../../generated/gallery.json";
import languages from "../../generated/languages.json";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props as { locale: Locale };
const msg = messages(locale);
const base = import.meta.env.BASE_URL;

const shot = (id: string) => showcase.entries.find((entry) => entry.id === id)!;
const component = (id: string) => gallery.entries.find((entry) => entry.id === id)!;

const hero = shot("kitchen");

// The same repository the footer links to, for the design records the "built" section cites.
const repo = process.env.REPO_SLUG ?? "limn-ui/limn";

// The version is filled in at build time (src/lib/version.mjs): no source file carries it, so a
// release never has to rewrite this page — see scripts/check-versions.sh at the root.
const gradle = `dependencies {
    implementation("io.github.limn-toolkit:limn-backend-lwjgl:${limnVersion()}")
}`;
// The same one dependency for a Maven build, in a tab beside it: every dependency block on the
// site is written for both tools, and a reader's choice holds for the whole page.
const maven = `<dependency>
  <groupId>io.github.limn-toolkit</groupId>
  <artifactId>limn-backend-lwjgl</artifactId>
  <version>${limnVersion()}</version>
</dependency>`;

// The two programs, runnable by alias, in RunCommand's two tabs: Windows and Linux, whose commands
// are the same, and macOS, whose carry the JVM flag. The aliases resolve the newest
// release from Maven Central, so nothing here carries a version; the note beside them does,
// filled in at build time like every {{version}} in the guides. Each comment sits on its own line
// above its command rather than trailing it: trailing, it made the macOS lines 95 characters
// wide, and the block took the section's width from the copy beside it.
const aliases = (flag: string) =>
  [
    `# ${msg("home.try.demoComment")}`,
    `jbang ${flag}demo@limn-toolkit/limn-toolkit`,
    `# ${msg("home.try.editorComment")}`,
    `jbang ${flag}theme-editor@limn-toolkit/limn-toolkit`,
  ].join("\n");

// The components row shows a handful of widgets rather than one, because "a set" is the
// claim it is making. Picked for variety of shape, not for importance.
const thumbs = ["button", "combo-box", "slider", "segmented-control", "checkbox", "spinner"].map(
  component,
);

const features = [
  {
    // `keys` and not `key`: every entry but the last lives under home.features.<name>, and the
    // languages quilt keeps the namespace its ten translations already use.
    keys: "home.features.layout",
    href: `${base}docs/layout/`,
    images: shot("layout").images,
    alt: msg("home.features.layout.alt"),
    caption: msg("home.features.layout.caption"),
  },
  {
    keys: "home.features.forms",
    href: `${base}docs/forms/`,
    images: shot("form").images,
    alt: msg("home.features.forms.alt"),
    caption: msg("home.features.forms.caption"),
  },
  {
    keys: "home.features.data",
    href: `${base}docs/lists-and-scrolling/`,
    images: shot("data").images,
    alt: msg("home.features.data.alt"),
    caption: msg("home.features.data.caption"),
  },
  {
    keys: "home.features.media",
    href: `${base}docs/images-and-media/`,
    images: shot("viewport-3d").images,
    alt: msg("home.features.media.alt"),
    caption: msg("home.features.media.caption"),
  },
] as const;

// The reader panel: what a screen reader is told about the form shown above, from the
// transcript the capture wrote beside its picture (one line per node, in reading order). Parsed
// only enough to typeset: the role and the name are the phrase a reader speaks first; where the
// name came from and the states follow, muted. Values and verbs are left out, because the panel
// shows what is heard on arrival and not everything the node offers.
const READER_LINES = 14;
const reader = ((shot("form") as { transcript?: string[] }).transcript ?? [])
  .filter((line) => !line.startsWith("=="))
  .map((line) => {
    const numbered = line.match(/^\s*\d+(\s+)(.*)$/);
    const depth = numbered ? Math.max(0, Math.floor((numbered[1].length - 1) / 2)) : 0;
    const phrase = numbered ? numbered[2] : line;
    const named = phrase.match(/^([^"]+?) "((?:[^"\\]|\\.)*)"\s*(.*)$/);
    if (!named) {
      return { depth, role: phrase, name: "", from: "", states: "" };
    }
    const tail = named[3];
    const from = tail.match(/^\(([^)]*)\)/)?.[1] ?? "";
    const states = tail.match(/\[([^\]]*)\]/)?.[1] ?? "";
    return { depth, role: named[1], name: named[2], from, states };
  })
  .filter((line) => line.role !== "window")
  .slice(0, READER_LINES);
if (reader.length === 0) {
  // The capture writes the transcript beside the picture; a form with nothing to read is a
  // capture that did not run, and a home page that hid the panel would ship that silently.
  throw new Error("home: the form showcase carries no transcript; re-run pnpm build:gallery");
}

---

<Page locale={locale} titleKey="home.title" descriptionKey="home.description">
  <section class="hero aura">
    <div class="hero__inner wrap">
      <div class="hero__copy">
        <p class="eyebrow">{msg("home.hero.eyebrow")}</p>
        <h1>{msg("home.hero.headline")}</h1>
        <p class="lede">{msg("home.hero.sub")}</p>
        <div class="button-row">
          <a class="button button--primary" href={`${base}docs/install/`}>
            {msg("home.hero.cta")}
          </a>
          <a class="button" href={localePath(base, locale, "components/")}>
            {msg("home.hero.secondary")}
          </a>
        </div>
        <p class="hero__meta">{msg("home.hero.meta")}</p>
        {/* Said above the fold on purpose: a reader deciding whether to trust the toolkit
            should not learn how it was made from somewhere else. The section it links to is
            the long form, near the end of the page. */}
        <p class="hero__built">
          {msg("home.hero.built")} <a href="#built">{msg("home.hero.builtLink")}</a>
        </p>
      </div>

      <Figure
        images={hero.images}
        alt={msg("home.hero.caption")}
        caption={msg("home.hero.caption")}
        base={base}
        eager
      />
    </div>

    {/* Under the headline and before the install: what it takes to SEE the toolkit is one
        command, and that answer belongs above the one that takes a build file. */}
    <div class="wrap try">
      <div class="try__copy">
        <h2>{msg("home.try.heading")}</h2>
        <p set:html={msg("home.try.body")} />
        <aside class="note">
          <Fragment set:html={msg("home.try.macosNote")} />
        </aside>
      </div>
      <RunCommand locale={locale} name="try-system" commands={aliases} />
    </div>
  </section>

  <section class="section" id="install">
    <div class="wrap">
      <p class="eyebrow">{msg("home.install.eyebrow")}</p>
      <h2 class="heading-rule"><span>{msg("home.install.heading")}</span></h2>
      <div class="install">
        <div class="install__copy">
          <p class="lede">{msg("home.install.body")}</p>
          <a class="arrow" href={`${base}docs/install/`}>{msg("home.install.more")}</a>
        </div>
        <div class="install__code">
          <CodeTabs
            name="install-build"
            sync="build"
            label={msg("codeTabs.buildTool")}
            tabs={[
              { id: "gradle", label: "Gradle", code: gradle, language: "kotlin", file: msg("home.install.gradleLabel") },
              { id: "maven", label: "Maven", code: maven, language: "xml", file: msg("home.install.mavenLabel") },
            ]}
            copyLabel={msg("codeBlock.copy")}
            copiedLabel={msg("codeBlock.copied")}
          />
          <CodeBlock
            code={snippet("hello-window")}
            language="java"
            file={msg("home.install.helloLabel")}
            label={msg("codeBlock.copy")}
            copiedLabel={msg("codeBlock.copied")}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{msg("home.features.eyebrow")}</p>
      <div class="features">
        <article class="feature">
          <div class="feature__copy">
            <h2>{msg("home.features.components.heading")}</h2>
            <p>{msg("home.features.components.body")}</p>
            <a class="arrow" href={localePath(base, locale, "components/")}>
              {msg("home.features.components.link")}
            </a>
          </div>
          <div class="thumbs plate">
            {
              thumbs.map((entry) => (
                <Screenshot images={entry.images} alt={entry.title} base={base} />
              ))
            }
          </div>
        </article>

        {
          features.map((feature) => (
            <article class="feature">
              <div class="feature__copy">
                <h2>{msg(`${feature.keys}.heading` as never)}</h2>
                <p>{msg(`${feature.keys}.body` as never)}</p>
                <a class="arrow" href={feature.href}>
                  {msg(`${feature.keys}.link` as never)}
                </a>
              </div>
              <Figure
                images={feature.images}
                alt={feature.alt}
                caption={feature.caption}
                base={base}
              />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="everyone">
    <div class="wrap">
      <p class="eyebrow">{msg("home.everyone.eyebrow")}</p>
      <h2 class="heading-rule"><span>{msg("home.everyone.heading")}</span></h2>
      <div class="features">
        <article class="feature">
          <div class="feature__copy">
            <h3>{msg("home.languages.heading")}</h3>
            <p>{msg("home.languages.body")}</p>
            <a class="arrow" href={`${base}docs/text-and-languages/`}>
              {msg("home.languages.link")}
            </a>
          </div>
          <Figure
            images={languages.images}
            alt={msg("home.languages.alt")}
            caption={msg("home.languages.caption")}
            base={base}
          />
        </article>

        <article class="feature">
          <div class="feature__copy">
            <h3>{msg("home.accessibility.heading")}</h3>
            <p>{msg("home.accessibility.body")}</p>
            <a class="arrow" href={`${base}docs/accessibility/`}>
              {msg("home.accessibility.link")}
            </a>
          </div>
          <figure class="figure">
            <div class="plate">
              <ol class="reader" aria-label={msg("home.accessibility.caption")}>
                {
                  reader.map((line) => (
                    <li style={`--depth: ${line.depth}`}>
                      <span class="reader__role">{line.role}</span>
                      {line.name && <span class="reader__name">“{line.name}”</span>}
                      {
                        (line.from || line.states) && (
                          <span class="reader__rest">
                            {[line.from, line.states].filter(Boolean).join(" · ")}
                          </span>
                        )
                      }
                    </li>
                  ))
                }
              </ol>
            </div>
            <figcaption class="plate__caption">{msg("home.accessibility.caption")}</figcaption>
          </figure>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <article class="themes">
        <div class="themes__copy">
          <h2>{msg("home.themes.heading")}</h2>
          <p>{msg("home.themes.body")}</p>
          {/* NOT localePath: the guide is English-only, one Starlight root locale, so a
              locale-prefixed /docs/ URL is a 404. Every other link into the guide on this page
              is built the same way, and this is the reason. */}
          <a class="arrow" href={`${base}docs/theming/`}>{msg("home.themes.link")}</a>
        </div>
        <figure class="figure">
          <div class="plate">
            <ThemeMosaic locale={locale} alt={msg("home.themes.alt")} />
          </div>
          <figcaption class="plate__caption">{msg("home.themes.caption")}</figcaption>
        </figure>
      </article>
    </div>
  </section>


  <section class="section" id="built">
    <div class="wrap">
      <div class="built">
        <p class="eyebrow">{msg("home.built.eyebrow")}</p>
        <h2>{msg("home.built.heading")}</h2>
        <p>{msg("home.built.intro")}</p>
        <p><Fragment set:html={msg("home.built.method")} /></p>
        <p>{msg("home.built.cost")}</p>
        <a class="arrow" href={`https://github.com/${repo}/tree/main/docs/adr`}>
          {msg("home.built.link")}
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="closing">
        <h2>{msg("home.closing.heading")}</h2>
        <p>{msg("home.closing.body")}</p>
        <div class="button-row">
          <a class="button button--primary" href={`${base}docs/install/`}>
            {msg("home.hero.cta")}
          </a>
          <a class="button" href={`${base}docs/`}>{msg("nav.docs")}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  /* ------------------------------------------------------------------ hero */

  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) 0;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  /* 5/7 rather than half and half: the headline wants a narrow measure and the capture
     wants every pixel it can get. */
  @media (min-width: 62rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .hero__copy .lede {
    margin-block: 1.5rem 2rem;
  }

  .hero__meta {
    margin-block-start: 1.5rem;
    color: var(--limn-text-muted);
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }

  .hero__built {
    margin-block-start: 0.75rem;
    max-inline-size: 52ch;
    color: var(--limn-text-muted);
    font-size: var(--text-sm);
  }

  /* ----------------------------------------------------------------- built */

  /* The hero links here, and the sticky bar would otherwise land over the eyebrow. */
  #built {
    scroll-margin-block-start: var(--limn-bar-height);
  }

  .built {
    max-inline-size: 68ch;
  }

  .built p:not(.eyebrow) {
    margin-block: 1rem 0;
    color: var(--limn-text-muted);
  }

  .built .arrow {
    display: inline-block;
    margin-block-start: 1.5rem;
  }

  /* ------------------------------------------------------------------- try */

  /* minmax(0, …) in every column, as .themes explains below: a bare column defaults to
     min-content, and on a phone the widest code line pushed the page 250px past the screen. */
  .try {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    padding-block-start: clamp(1.5rem, 3vw, 2.25rem);
    border-block-start: 1px solid var(--rule);
  }

  /* The same split as the install below it, and for the same reason: the commands are the
     widest thing in this section, and they get the wide column. Not the width their longest
     line asks for: a max-content column took 953px of a 1280px window and left the copy at its
     192px floor, 588px tall beside an 86px block. A line longer than its column scrolls inside
     the block, as every code block's does. */
  @media (min-width: 62rem) {
    .try {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  .try__copy h2 {
    font-size: var(--text-2xl);
  }

  .try__copy p {
    margin-block-start: 0.75rem;
    max-inline-size: 46ch;
    color: var(--limn-text-muted);
  }

  /* --------------------------------------------------------------- install */

  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
    margin-block-start: 2.25rem;
  }

  /* The prose column is the narrow one: a Java sample is the widest thing on this page,
     and splitting the width evenly puts its longest line behind a horizontal scroll on a
     desktop, which is the one place there is no excuse for it. */
  @media (min-width: 62rem) {
    .install {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  .install__copy,
  .install__code {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  /* A callout is a border and a tint, never a glow, because it has to survive greyscale. */
  .note {
    margin-block-start: 1.25rem;
    padding: 1rem 1.15rem;
    border-inline-start: 2px solid var(--limn-primary);
    /* Square where the accent border sits, rounded on the far side, whichever side that is. */
    border-start-end-radius: 8px;
    border-end-end-radius: 8px;
    background-color: var(--tint);
    color: var(--limn-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  /* A flag is one word: broken at its hyphen, "-XstartOnFirstThread" ended a line on a bare
     "–" that read as a dash, and the flag below it lost the sign a reader has to type. */
  .note :global(code) {
    white-space: nowrap;
  }

  .arrow {
    justify-self: start;
    font-size: var(--text-sm);
    font-weight: 560;
    text-decoration: none;
  }

  .arrow::after {
    content: var(--arrow-onward);
    transition: translate 140ms var(--ease);
    display: inline-block;
  }

  .arrow:hover::after {
    translate: var(--nudge-onward) 0;
  }

  /* -------------------------------------------------------------- features */

  .features {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 6vw, 5.5rem);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 58rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    /* Alternating, so the eye zig-zags down the page instead of running down one gutter. */
    .feature:nth-child(even) .feature__copy {
      order: 2;
    }
  }

  .feature h2,
  .feature h3 {
    font-size: var(--text-2xl);
  }

  /* The reader panel: a transcript typeset as a list, indented by depth in the tree. */
  .reader {
    margin: 0;
    padding: 0.35rem 0.5rem;
    list-style: none;
    font-family: var(--mono);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .reader li {
    padding-inline-start: calc(var(--depth, 0) * 1.1rem);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .reader__role {
    color: var(--limn-primary);
  }

  .reader__name {
    margin-inline-start: 0.4em;
  }

  .reader__rest {
    margin-inline-start: 0.6em;
    color: var(--limn-text-muted);
    font-size: var(--text-xs);
  }

  .feature p {
    margin-block: 1rem 1.5rem;
    max-inline-size: 46ch;
    color: var(--limn-text-muted);
  }

  .thumbs {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    background-color: var(--tint);
  }

  .thumbs :global(.shot) {
    padding: 0.75rem;
    border-radius: 10px;
    background-color: var(--limn-background);
    block-size: 100%;
    align-content: center;
  }

  /* ---------------------------------------------------------------- themes */

  /* The mosaic sits BESIDE the copy, and it takes the wider column. Seven strips inside half
     a page are eighty pixels each: a texture, not a screenshot, and this section's whole
     argument is that a reader can see real controls wearing different clothes. */
  .themes {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 58rem) {
    .themes {
      /* minmax(0, …) rather than a bare fraction: a grid column defaults to min-content, and
         a 1024px-wide image then pushes the column past its share and the copy off the page. */
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    /* Picture first, because the feature above this one ends picture-right: the zig-zag down the
       page does not stop where the features grid does. */
    .themes__copy {
      order: 2;
    }
  }

  .themes__copy h2 {
    font-size: var(--text-2xl);
  }

  .themes__copy p {
    margin-block: 1rem 1.5rem;
    max-inline-size: 42ch;
    color: var(--limn-text-muted);
  }

  /* --------------------------------------------------------------- closing */

  .closing {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 18px;
    background-color: var(--tint);
    text-align: center;
  }

  .closing h2 {
    max-inline-size: 18ch;
  }

  .closing p {
    max-inline-size: 48ch;
    color: var(--limn-text-muted);
  }

  .closing .button-row {
    margin-block-start: 0.5rem;
    justify-content: center;
  }
</style>
