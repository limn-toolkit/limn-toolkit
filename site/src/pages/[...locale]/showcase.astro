---
/**
 * Whole screens, at the size they were captured. Each one has a heading and a sentence
 * saying what it is evidence of, because a picture with no claim attached is decoration.
 */
import Page from "../../layouts/Page.astro";
import Figure from "../../components/Figure.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import RunCommand from "../../components/RunCommand.astro";
import { snippet } from "../../lib/snippets";
import { localeRoutes, messages } from "../../i18n";
import type { Locale } from "../../lib/i18n";
import showcase from "../../generated/showcase.json";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props as { locale: Locale };
const msg = messages(locale);
const base = import.meta.env.BASE_URL;

const byId = new Map(showcase.entries.map((entry) => [entry.id, entry]));

// The two programs a reader can open from here, by alias, in RunCommand's per-system tabs.
const run = (alias: string) => (flag: string) => `jbang ${flag}${alias}@limn-toolkit/limn-toolkit`;

// The source of a screen that is an example rather than a program: the marked regions of the
// class that drew the capture, the scene first and then what it calls, so a reader who scrolls
// down meets each name after its use. The regions are the same compiled code the guides quote.
const source = (...regions: string[]) => regions.map(snippet).join("\n\n");

const plates = [
  { key: "kitchen", id: "kitchen", command: run("demo") },
  // Straight after the window it mirrors, so the two read as one before/after pair. The
  // capture is the whole window on purpose: mirroring is a property of the window, and a
  // crop of it would show a right-aligned form, not a mirrored screen.
  { key: "rtl", id: "kitchen-ar" },
  {
    key: "forms",
    id: "form",
    code: source(
      "showcase:form-scene",
      "guide:form",
      "guide:form-field",
      "guide:form-counter",
      "guide:form-validation",
      "guide:form-actions",
    ),
  },
  {
    key: "layout",
    id: "layout",
    code: source(
      "showcase:layout-scene",
      "guide:layout-shell",
      "showcase:layout-collections",
      "showcase:layout-library",
      "showcase:layout-tile",
      "showcase:layout-swatch",
      "showcase:layout-data",
      "guide:layout-column",
      "guide:layout-row",
      "guide:layout-stack",
      "guide:layout-grid",
    ),
  },
  { key: "density", id: "control-size" },
  { key: "threeD", id: "viewport-3d" },
  // Last, and the only filmed one: it is a program of its own rather than part of the toolkit,
  // and what it claims (a window re-skinning as you drag) is the one thing on this page a still
  // cannot carry. Screenshot draws the play control when the entry has frames.
  { key: "editor", id: "theme-editor", command: run("theme-editor") },
] as const satisfies ReadonlyArray<{
  key: string;
  id: string;
  command?: (flag: string) => string;
  code?: string;
}>;

---

<Page
  locale={locale}
  path="showcase/"
  titleKey="showcase.title"
  descriptionKey="showcase.description"
>
  <section class="section aura">
    <div class="wrap">
      <p class="eyebrow">{msg("showcase.eyebrow")}</p>
      <h1>{msg("showcase.heading")}</h1>
      <p class="lede intro">{msg("showcase.lede")}</p>

      <div class="plates">
        {
          plates.map((plate) => {
            const entry = byId.get(plate.id)!;
            const command = "command" in plate ? plate.command : undefined;
            const code = "code" in plate ? plate.code : undefined;
            return (
              <section class="item">
                <div class="item__copy">
                  <h2>{msg(`showcase.${plate.key}.heading` as never)}</h2>
                  <p>{msg(`showcase.${plate.key}.body` as never)}</p>
                </div>
                {command && <RunCommand locale={locale} name={`run-${plate.key}`} commands={command} />}
                <Figure
                  images={entry.images}
                  alt={entry.title}
                  base={base}
                  playLabel={msg("components.play")}
                  stopLabel={msg("components.stop")}
                />
                {code && (
                  <details class="code-disclosure">
                    <summary>{msg("components.showCode")}</summary>
                    <CodeBlock
                      code={code}
                      language="java"
                      label={msg("codeBlock.copy")}
                      copiedLabel={msg("codeBlock.copied")}
                    />
                  </details>
                )}
              </section>
            );
          })
        }

      </div>
    </div>
  </section>
</Page>

<style>
  .intro {
    margin-block: 1.25rem 0;
  }

  .plates {
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
  }

  .item {
    display: grid;
    gap: 1.5rem;
  }

  .item__copy {
    display: grid;
    gap: 0.75rem;
    max-inline-size: 62ch;
  }

  .item h2 {
    font-size: var(--text-2xl);
  }

  .item p {
    color: var(--limn-text-muted);
  }

  .locales {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
</style>
