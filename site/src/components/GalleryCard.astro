---
/**
 * One component: its capture, its name, and the code that produced the capture, with the
 * code folded away, because the grid is what a reader scans and thirty open code blocks is
 * not a grid.
 *
 * `data-name` is what the filter on the page matches against, so the filter never has to
 * read into the card's markup. It carries every name a reader might type (the title, the
 * entry id spaced and unspaced, and the page's synonyms), because the title alone is not
 * how readers search: "dropdown" must find ComboBox.
 */
import Screenshot from "./Screenshot.astro";
import CodeBlock from "./CodeBlock.astro";

interface Props {
  id: string;
  title: string;
  snippet: string;
  images: Record<
    string,
    {
      png?: string;
      avif: string;
      webp: string;
      width: number;
      height: number;
      animation?: { webp: string; frames: number; durationMs: number };
    }
  >;
  base: string;
  /** Extra words the filter should match for this entry, beyond its title and id. */
  keywords?: string[];
  showCodeLabel: string;
  copyLabel: string;
  copiedLabel: string;
  playLabel: string;
  stopLabel: string;
  note?: string;
}

const {
  id,
  title,
  snippet,
  images,
  base,
  keywords,
  showCodeLabel,
  copyLabel,
  copiedLabel,
  playLabel,
  stopLabel,
  note,
} = Astro.props;

// The filter matches by substring, so this holds the title, the id in both its hyphenated
// and spaced forms ("text field" with the space must work), and the page's synonyms.
const searchable = [title, id, id.replaceAll("-", " "), ...(keywords ?? [])]
  .join(" ")
  .toLowerCase();

// Only the entries the capture actually filmed get a control. The manifest decides, not
// this component: an entry that stops being filmed loses its button by rebuilding.
const filmed = Object.values(images).some((image) => image.animation);
---

<article class="card" id={id} data-name={searchable}>
  <div class="card__shot">
    <Screenshot images={images} alt={title} base={base} />
    {
      filmed && (
        <button
          class="card__play"
          type="button"
          data-play
          data-play-label={playLabel}
          data-stop-label={stopLabel}
          aria-pressed="false"
          hidden
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path class="card__glyph-play" d="M8 5.5v13l11-6.5z" />
            <rect class="card__glyph-stop" x="7" y="6" width="10" height="12" rx="1.5" />
          </svg>
          <span data-play-text>{playLabel}</span>
        </button>
      )
    }
  </div>
  <div class="card__foot">
    <h2>{title}</h2>
    <details class="card__code">
      <summary>{showCodeLabel}</summary>
      <CodeBlock code={snippet} language="java" label={copyLabel} copiedLabel={copiedLabel} />
      {note && <p class="card__note" set:html={note} />}
    </details>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background-color: var(--limn-background);
    overflow: hidden;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--limn-primary) 45%, transparent);
  }

  /* The capture sits on the tint rather than on the card, so the widget's own background
     is visibly a screenshot and not part of the page furniture. */
  /* One height for every capture, so the names line up across a row. Without it a grid of
     thirty cards has thirty different baselines and reads as a pile rather than a set. */
  .card__shot {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: 14rem;
    padding: 1.25rem;
    background-color: var(--tint);
    border-block-end: 1px solid var(--rule);
    overflow: hidden;
  }

  /* Rendered hidden and revealed by the script: with no JavaScript there is nothing to
     start the film, and a control that does nothing is worse than no control. */
  /* 44px is the same floor `.button` and the page's filter field stand on. Shrinking this
     one because it overlays a picture would make it the only control on the site with a
     smaller target. */
  .card__play {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-end: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    /* 36, not 44: the glyph carries the control now, so the box stops being mostly padding.
       Still comfortably over the 24 px minimum a pointer target needs, and the label beside it
       widens the hit area past its height in the direction a thumb actually misses. */
    min-block-size: 36px;
    padding-inline: 0.45rem 0.7rem;
    border: 1px solid var(--limn-outline);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--limn-background) 88%, transparent);
    backdrop-filter: blur(6px);
    color: var(--limn-text-muted);
    font-size: var(--text-xs);
    font-weight: 560;
    cursor: pointer;
  }

  .card__play:hover {
    border-color: var(--limn-primary);
    color: var(--limn-text);
  }

  .card__glyph-stop {
    display: none;
  }

  .card__play[aria-pressed="true"] {
    border-color: transparent;
    background-color: var(--limn-primary);
    color: var(--limn-on-primary);
  }

  .card__play[aria-pressed="true"] .card__glyph-play {
    display: none;
  }

  .card__play[aria-pressed="true"] .card__glyph-stop {
    display: inline;
  }

  /* The ceiling the tallest capture (the colour picker) is measured against: below this
     its channel rails stop reading as sliders. */
  .card__shot :global(img) {
    max-block-size: 12rem;
    inline-size: auto;
  }

  .card__foot {
    padding: 1rem 1.15rem 1.15rem;
  }

  .card h2 {
    font-size: var(--text-base);
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  /* `list-item`, never an inline display: any author `display` that is not a list-item
     removes the disclosure triangle in Chromium, and the triangle is the only sign the
     snippet exists. The marker's type stays with the user agent so it still flips between
     closed and open. The padding lifts a single 12px line of text to a hit target that
     clears the 24px floor. */
  .card__code summary {
    display: list-item;
    list-style-position: inside;
    margin-block-start: 0.45rem;
    padding-block: 0.3rem;
    color: var(--limn-text-muted);
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .card__code summary:hover {
    color: var(--limn-primary);
  }

  .card__code[open] summary {
    color: var(--limn-primary);
  }

  .card__code :global(.code) {
    margin-block-start: 0.75rem;
  }

  .card__note {
    margin-block-start: 0.75rem;
    color: var(--limn-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>

<script>
  // The toggle itself is shared with the showcase's plates; see src/lib/film-toggle.ts.
  import { bindFilmControls } from "../lib/film-toggle";

  bindFilmControls();
</script>
